{
  "name": "ayuva",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build":"ng build",
    "start:local": "ng serve --host  dev1 --configuration=local",
    "start:dev": "ng serve --configuration=development --base-href='./'",
    "start:staging": "ng serve  --host --configuration=staging  --base-href='./'",
    "start:prod": "ng serve AYUVA --configuration=production  --base-href='./'",

    "build:local": "ng build dev",
    "build:staging": "ng build staging",
    "build:prod": "ng build AYUVA --configuration production",

    "watch": "ng build dev --watch",

    "test": "ng test AYUVA",

    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\""
  },
  "private": true,
  "packageManager": "yarn@4.14.1",
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "5.3.8",
    "primeicons": "^8.0.0",
    "primeng": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
